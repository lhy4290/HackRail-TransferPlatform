        <mxCell id="sg_note" value="Security Group：只收 CloudFront IP&lt;br&gt;Listener：X-Origin-Verify 標頭不符回 403" style="text;html=1;align=left;verticalAlign=middle;whiteSpace=wrap;fontSize=10;fontColor=#545B64;" vertex="1" parent="1">
          <mxGeometry x="375" y="440" width="250" height="40" as="geometry" />
        </mxCell>
        <mxCell id="task_a" value="Task A&lt;br&gt;FastAPI ＋ React" style="sketch=0;points=[];outlineConnect=0;fontColor=#232F3E;fillColor=#ED7100;strokeColor=#ffffff;dashed=0;verticalLabelPosition=bottom;verticalAlign=top;align=center;html=1;fontSize=12;fontStyle=0;aspect=fixed;shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.fargate;" vertex="1" parent="1">
          <mxGeometry x="705" y="200" width="60" height="60" as="geometry" />
        </mxCell>
        <mxCell id="task_b" value="Task B&lt;br&gt;（Auto Scaling 1–2）" style="sketch=0;points=[];outlineConnect=0;fontColor=#232F3E;fillColor=#ED7100;strokeColor=#ffffff;dashed=0;verticalLabelPosition=bottom;verticalAlign=top;align=center;html=1;fontSize=12;fontStyle=0;aspect=fixed;shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.fargate;opacity=60;" vertex="1" parent="1">
          <mxGeometry x="705" y="395" width="60" height="60" as="geometry" />
        </mxCell>
        <mxCell id="igw" value="Internet&lt;br&gt;Gateway" style="sketch=0;outlineConnect=0;fontColor=#232F3E;gradientColor=none;fillColor=#8C4FFF;strokeColor=none;dashed=0;verticalLabelPosition=bottom;verticalAlign=top;align=center;html=1;fontSize=12;fontStyle=0;aspect=fixed;pointerEvents=1;shape=mxgraph.aws4.internet_gateway;" vertex="1" parent="1">
          <mxGeometry x="915" y="290" width="60" height="60" as="geometry" />
        </mxCell>

        <!-- ===== Regional services ===== -->
        <mxCell id="ecr" value="ECR&lt;br&gt;映像倉庫（推送時掃描）" style="sketch=0;points=[];outlineConnect=0;fontColor=#232F3E;fillColor=#ED7100;strokeColor=#ffffff;dashed=0;verticalLabelPosition=bottom;verticalAlign=top;align=center;html=1;fontSize=12;fontStyle=0;aspect=fixed;shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.ecr;" vertex="1" parent="1">
          <mxGeometry x="390" y="610" width="60" height="60" as="geometry" />
        </mxCell>
        <mxCell id="secrets" value="Secrets Manager&lt;br&gt;TDX 憑證" style="sketch=0;points=[];outlineConnect=0;fontColor=#232F3E;fillColor=#DD344C;strokeColor=#ffffff;dashed=0;verticalLabelPosition=bottom;verticalAlign=top;align=center;html=1;fontSize=12;fontStyle=0;aspect=fixed;shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.secrets_manager;" vertex="1" parent="1">
          <mxGeometry x="560" y="610" width="60" height="60" as="geometry" />
        </mxCell>
        <mxCell id="cloudwatch" value="CloudWatch&lt;br&gt;Logs／Alarms" style="sketch=0;points=[];outlineConnect=0;fontColor=#232F3E;fillColor=#E7157B;strokeColor=#ffffff;dashed=0;verticalLabelPosition=bottom;verticalAlign=top;align=center;html=1;fontSize=12;fontStyle=0;aspect=fixed;shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.cloudwatch_2;" vertex="1" parent="1">
          <mxGeometry x="730" y="610" width="60" height="60" as="geometry" />
        </mxCell>
        <mxCell id="sns" value="SNS&lt;br&gt;告警 Email" style="sketch=0;points=[];outlineConnect=0;fontColor=#232F3E;fillColor=#E7157B;strokeColor=#ffffff;dashed=0;verticalLabelPosition=bottom;verticalAlign=top;align=center;html=1;fontSize=12;fontStyle=0;aspect=fixed;shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.sns;" vertex="1" parent="1">
          <mxGeometry x="900" y="610" width="60" height="60" as="geometry" />
        </mxCell>
        <mxCell id="s3" value="S3&lt;br&gt;Terraform state" style="sketch=0;points=[];outlineConnect=0;fontColor=#232F3E;fillColor=#7AA116;strokeColor=#ffffff;dashed=0;verticalLabelPosition=bottom;verticalAlign=top;align=center;html=1;fontSize=12;fontStyle=0;aspect=fixed;shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.s3;" vertex="1" parent="1">
          <mxGeometry x="1070" y="610" width="60" height="60" as="geometry" />
        </mxCell>

        <!-- ===== Request path (solid) ===== -->
        <mxCell id="e_user_cf" value="HTTPS" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#232F3E;strokeWidth=2;fontSize=11;" edge="1" parent="1" source="users" target="cloudfront">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e_cf_alb" value="HTTP＋密值標頭" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#232F3E;strokeWidth=2;fontSize=11;" edge="1" parent="1" source="cloudfront" target="alb">
          <mxGeometry relative="1" as="geometry" />
