        <mxCell id="e_cw_sns" value="告警" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#E7157B;fontSize=10;" edge="1" parent="1" source="cloudwatch" target="sns">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <!-- ===== CI/CD (blue) ===== -->
        <mxCell id="e_gh_iam" value="OIDC 換臨時憑證" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#147EBA;fontSize=10;fontColor=#147EBA;" edge="1" parent="1" source="github" target="iam">
