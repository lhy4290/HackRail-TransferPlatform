        <mxCell id="e_alb_b" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#232F3E;strokeWidth=2;" edge="1" parent="1" source="alb" target="task_b">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e_a_igw" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#ED7100;" edge="1" parent="1" source="task_a" target="igw">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e_b_igw" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#ED7100;" edge="1" parent="1" source="task_b" target="igw">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e_igw_tdx" value="HTTPS（OAuth2）" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#ED7100;fontSize=11;" edge="1" parent="1" source="igw" target="tdx">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <!-- ===== Supporting flows (dashed) ===== -->
        <mxCell id="e_ecr_b" value="pull image" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=open;dashed=1;strokeColor=#545B64;fontSize=10;" edge="1" parent="1" source="ecr" target="task_b">
          <mxGeometry relative="1" as="geometry" />
