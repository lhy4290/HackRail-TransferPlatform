        <mxCell id="e_sec_b" value="啟動時注入" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=open;dashed=1;strokeColor=#DD344C;fontSize=10;" edge="1" parent="1" source="secrets" target="task_b">
