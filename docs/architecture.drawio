        <mxCell id="e_alb_a" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#232F3E;strokeWidth=2;" edge="1" parent="1" source="alb" target="task_a">
          <mxGeometry relative="1" as="geometry" />
