        <mxCell id="e_iam_ecr" value="push image" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#147EBA;fontSize=10;fontColor=#147EBA;" edge="1" parent="1" source="iam" target="ecr">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e_iam_ecs" value="更新 ECS 服務" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#147EBA;fontSize=10;fontColor=#147EBA;exitX=0.5;exitY=0;entryX=0;entryY=0.15;" edge="1" parent="1" source="iam" target="g_ecs">
          <mxGeometry relative="1" as="geometry">
            <Array as="points">
              <mxPoint x="230" y="560" />
              <mxPoint x="610" y="560" />
              <mxPoint x="610" y="211" />
            </Array>
          </mxGeometry>
        </mxCell>

        <!-- ===== Legend ===== -->
        <mxCell id="legend" value="&lt;b&gt;圖例&lt;/b&gt;　━ 使用者請求　━ 對外呼叫 TDX　┅ 啟動／日誌　━ CI/CD 部署" style="text;html=1;align=left;verticalAlign=middle;fontSize=11;fontColor=#545B64;" vertex="1" parent="1">
