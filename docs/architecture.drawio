        <mxCell id="e_b_cw" value="日誌" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=open;dashed=1;strokeColor=#E7157B;fontSize=10;" edge="1" parent="1" source="task_b" target="cloudwatch">
